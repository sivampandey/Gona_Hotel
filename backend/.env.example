# Gona Hotel Backend Production Environment Variables
PORT=5000
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.example.mongodb.net/gona_hotel?retryWrites=true&w=majority
JWT_SECRET=<generate_secure_random_jwt_secret_key>
CORS_ORIGIN=https://gona-hotel.vercel.app,http://localhost:5173

# Resend Email Configuration
RESEND_API_KEY=
RESEND_FROM_EMAIL="Gona Hotel Concierge <onboarding@resend.dev>"
FRONTEND_URL=https://gona-hotel.vercel.app

